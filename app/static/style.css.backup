* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;
  background: #1a1a1a;
  color: #e0e0e0;
  padding: 20px;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30px;
  padding-bottom: 20px;
  border-bottom: 2px solid #333;
}

.header h1 {
  color: #4a9eff;
  font-size: 32px;
}

.status-chips {
  display: flex;
  gap: 10px;
}

.chip {
  padding: 8px 16px;
  border-radius: 20px;
  background: #2a2a2a;
  font-size: 14px;
  border: 1px solid #444;
}

.chip.success {
  background: #1a3a1a;
  border-color: #4aff4a;
  color: #4aff4a;
}

.main-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  margin-bottom: 20px;
}

.panel {
  background: #2a2a2a;
  border-radius: 12px;
  padding: 20px;
  border: 1px solid #444;
}

.panel h2 {
  color: #4a9eff;
  margin-bottom: 15px;
  font-size: 20px;
}

.form-group {
  margin-bottom: 15px;
}

.form-group label {
  display: block;
  margin-bottom: 5px;
  color: #aaa;
  font-size: 14px;
}

select {
  width: 100%;
  padding: 10px;
  background: #1a1a1a;
  color: #e0e0e0;
  border: 1px solid #444;
  border-radius: 6px;
  font-size: 16px;
}

button {
  padding: 12px 24px;
  border: none;
  border-radius: 6px;
  font-size: 16px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s;
}

button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.btn-primary {
  background: #4a9eff;
  color: white;
}

.btn-primary:hover:not(:disabled) {
  background: #3a8eef;
  transform: translateY(-1px);
  box-shadow: 0 4px 8px rgba(74, 158, 255, 0.3);
}

.btn-success {
  background: #4aff4a;
  color: #1a1a1a;
}

.btn-success:hover:not(:disabled) {
  background: #3aef3a;
  transform: translateY(-1px);
  box-shadow: 0 4px 8px rgba(74, 255, 74, 0.3);
}

.btn-danger {
  background: #ff4a4a;
  color: white;
}

.btn-danger:hover:not(:disabled) {
  background: #ef3a3a;
}

.btn-secondary {
  background: #444;
  color: #e0e0e0;
}

.btn-secondary:hover:not(:disabled) {
  background: #555;
}

.motion-controls {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
  margin-top: 15px;
}

.jog-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 5px;
  margin: 10px 0;
}

.jog-btn {
  padding: 15px;
  background: #333;
  border: 1px solid #555;
  color: #e0e0e0;
  border-radius: 6px;
  font-size: 18px;
  cursor: pointer;
}

.jog-btn:hover {
  background: #444;
}

.jog-btn:active {
  background: #555;
}

.cell-grid {
  display: grid;
  grid-template-columns: repeat(11, 1fr);
  gap: 5px;
  margin-top: 15px;
}

.cell {
  aspect-ratio: 1;
  background: #333;
  border: 2px solid #555;
  border-radius: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
  font-size: 14px;
  cursor: pointer;
  transition: all 0.2s;
}

.cell:hover {
  background: #444;
  border-color: #4a9eff;
}

.cell.active {
  background: #4a9eff;
  color: white;
  border-color: #4a9eff;
}

.cell.feeder {
  background: #3a2a1a;
  border-color: #ff9944;
}

.card-preview {
  background: #1a1a1a;
  border-radius: 8px;
  padding: 20px;
  margin-top: 15px;
  border: 2px solid #444;
}

.card-preview.identified {
  border-color: #4aff4a;
}

.card-name {
  font-size: 24px;
  font-weight: bold;
  color: #4aff4a;
  margin-bottom: 10px;
}

.card-info {
  display: flex;
  gap: 20px;
  margin-bottom: 15px;
  flex-wrap: wrap;
}

.info-item {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.info-label {
  color: #888;
  font-size: 12px;
  text-transform: uppercase;
}

.info-value {
  color: #e0e0e0;
  font-size: 16px;
  font-weight: 600;
}

.destination-cell {
  background: #ff9944;
  color: #1a1a1a;
  padding: 15px;
  border-radius: 8px;
  font-size: 18px;
  font-weight: bold;
  text-align: center;
  margin-top: 15px;
}

.snapshot-images {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
  margin-top: 15px;
}

.snapshot-img {
  width: 100%;
  border-radius: 6px;
  border: 1px solid #444;
}

.status-message {
  padding: 10px;
  border-radius: 6px;
  margin-top: 10px;
  font-size: 14px;
}

.status-message.info {
  background: #1a3a5a;
  color: #4a9eff;
}

.status-message.success {
  background: #1a3a1a;
  color: #4aff4a;
}

.status-message.error {
  background: #3a1a1a;
  color: #ff4a4a;
}

.full-width {
  grid-column: 1 / -1;
}
